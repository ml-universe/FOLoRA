# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.idea/
.vscode/
build/
dist/

# 数据（大文件，含 CIFAR 原始数据与解压产物）
/data/

# 实验产物（日志 + checkpoint，可断点续训重建）
/experiments/
reports/*.log*

# 模型权重
/models/
*.pth
*.pt
*.safetensors
*.bin

# 环境
.env
venv/
.venv/

# 运行时状态（队列守护每次 tick 都会重写，进版本库只会产生噪声 diff）
reports/.supervise_all.lock
reports/.last_progress_report.json

# 临时校验脚本（一次性核对用，不属于可复现管线）
_figcheck/
